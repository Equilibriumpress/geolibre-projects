      "cues": [
        {
          "kind": "annotation",
          "atMs": 2200,
          "text": "High means high relative to other Utrecht neighbourhoods.",
          "position": "bottom",
          "source": "CBS Wijken en Buurten 2025"
        }
      ]
    },
    {
      "id": "north-flyover",
      "type": "map",
      "durationMs": 4500,
      "headline": "Fly through the northern part of the city",
      "scenarioId": "ageing-density",
      "camera": {
        "center": [
          5.111,
          52.119
        ],
        "zoom": 14,
