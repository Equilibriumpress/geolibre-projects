      "scenarioId": "ageing-density",
      "camera": {
        "center": [
          5.116,
          52.112
        ],
        "zoom": 13.1,
        "pitch": 67,
        "bearing": 22,
        "transitionMs": 3000
      },
      "transition": "fly",
