{
  "version": "0.1.0",
  "title": "Where ageing meets density in Utrecht",
  "preset": "tiktok",
  "aspectRatio": "9:16",
  "fps": 30,
  "output": {
    "bitrateMbps": 20,
    "showSafeArea": true,
    "includeBranding": true
  },
  "scenes": [
    {
      "id": "intro",
      "type": "title",
      "durationMs": 2500,
      "headline": "Where ageing meets density in Utrecht",
      "subhead": "CBS neighbourhood data · 2025",
      "transition": "cut",
      "camera": {
        "center": [
          5.1214,
          52.0907
        ],
        "zoom": 9.2,
        "pitch": 20,
        "bearing": 0,
        "transitionMs": 0
      },
      "cues": [
        {
          "kind": "annotation",
          "atMs": 900,
          "text": "One city. Two demographic signals.",
          "position": "bottom",
          "source": "CBS via PDOK"
        }
      ]
    },
    {
      "id": "city-reveal",
      "type": "map",
      "durationMs": 4000,
      "headline": "Two signals become one comparable index",
      "subhead": "50% population density · 50% residents aged 65+",
      "scenarioId": "ageing-density",
      "camera": {
        "center": [
          5.1214,
          52.0907
        ],
        "zoom": 11.2,
        "pitch": 52,
        "bearing": -12,
        "transitionMs": 2600
      },
      "transition": "fly",
      "cues": [
        {
          "kind": "layer",
          "atMs": 0,
          "layerId": "investment-priority-lab-results",
          "visible": true,
          "opacity": 0.88
        },
        {
          "kind": "annotation",
          "atMs": 1700,
          "text": "Each indicator is percentile-ranked within Utrecht.",
          "position": "bottom",
          "source": "analysis.sql"
        }
      ]
    },
    {
      "id": "high-scores",
      "type": "highlight",
      "durationMs": 5000,
      "headline": "The highest combined scores emerge",
      "layerId": "investment-priority-lab-results",
