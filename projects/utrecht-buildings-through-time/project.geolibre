        "extrusionOpacity": 0.9,
        "extrusionHeightProperty": "height",
        "extrusionHeightScale": 1,
        "extrusionBase": 0,
        "extrusionAdvancedStyleEnabled": false,
        "extrusionColorExpression": "",
        "extrusionHeightExpression": "",
        "elevation3dEnabled": false,
        "elevation3dVerticalScale": 1,
        "elevation3dOffset": 0,
        "vectorStyleMode": "expression",
        "vectorStyleProperty": "bouwjaar",
        "vectorStyleClassCount": 6,
        "vectorStyleColorRamp": "oranges",
        "vectorStyleClassificationScheme": "equal-interval",
        "vectorStyleStops": [
          {
            "value": 1700,
            "color": "#5b3a29"
          },
          {
            "value": 1850,
            "color": "#8b5a3c"
          },
          {
