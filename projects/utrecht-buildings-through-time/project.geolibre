  "styles": {},
  "widgets": [
    {
      "id": "sample-building-count",
      "layerId": "utrecht-bag-dashboard-sample",
      "type": "indicator",
      "indicatorAggregation": "count",
      "title": "Buildings in dashboard sample"
    },
    {
      "id": "sample-build-year",
      "layerId": "utrecht-bag-dashboard-sample",
      "type": "histogram",
      "field": "bouwjaar",
      "bins": 12,
      "title": "Construction year · central sample"
    },
    {
      "id": "sample-use",
      "layerId": "utrecht-bag-dashboard-sample",
      "type": "bar",
      "category": "gebruiksdoel",
      "aggregation": "count",
      "title": "Use functions · central sample"
    }
  ],
  "dashboardColumns": 2,
  "storymap": {
    "title": "How Utrecht grew",
    "subtitle": "Current BAG building stock by recorded construction year",
    "byline": "GeoLibre · Kadaster / PDOK",
    "footer": "Source: BAG via PDOK. Current-stock replay, not a reconstruction of demolished buildings.",
    "theme": "light",
    "showMarkers": true,
    "markerColor": "#bd743e",
    "inset": false,
    "insetPosition": "bottom-right",
    "chapters": [
      {
        "id": "netherlands",
        "title": "The Netherlands",
        "description": "Start at national scale. Utrecht is the case study; the detailed BAG building layer appears once the story reaches close urban scale.",
