        "hidden": false,
        "location": {
          "center": [
            5.29,
            52.13
          ],
          "zoom": 6.2,
          "pitch": 18,
          "bearing": 0
        },
        "mapAnimation": "flyTo",
        "rotateAnimation": false,
        "onChapterEnter": [
          {
            "layerId": "utrecht-bag-buildings",
            "opacity": 0
          }
        ],
        "onChapterExit": []
      },
      {
        "id": "utrecht",
        "title": "Utrecht",
        "description": "The city grew outward from a compact historic core. Use the Time Slider to replay the recorded construction years cumulatively.",
