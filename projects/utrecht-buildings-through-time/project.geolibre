        },
        "mapAnimation": "flyTo",
        "rotateAnimation": false,
        "onChapterEnter": [
          {
            "layerId": "utrecht-bag-buildings",
            "opacity": 0
          }
        ],
        "onChapterExit": []
      },
      {
        "id": "before-1700",
        "title": "Up to 1700",
        "description": "Zoom into the Binnenstad to inspect the oldest surviving building stock in the current BAG.",
        "alignment": "left",
        "hidden": false,
        "location": {
          "center": [
            5.1211,
            52.0908
          ],
          "zoom": 17.2,
          "pitch": 56,
          "bearing": -20
        },
        "mapAnimation": "flyTo",
        "rotateAnimation": false,
        "onChapterEnter": [
          {
            "layerId": "utrecht-bag-buildings",
            "opacity": 1
          }
        ],
        "onChapterExit": []
      },
      {
        "id": "to-1900",
        "title": "1850–1900",
        "description": "Nineteenth-century growth becomes legible around the historic core and transport corridors.",
        "alignment": "right",
        "hidden": false,
        "location": {
          "center": [
            5.116,
            52.094
          ],
          "zoom": 17.1,
          "pitch": 58,
          "bearing": 18
        },
        "mapAnimation": "flyTo",
        "rotateAnimation": false,
        "onChapterEnter": [
          {
            "layerId": "utrecht-bag-buildings",
            "opacity": 1
          }
        ],
        "onChapterExit": []
      },
      {
        "id": "postwar",
        "title": "Post-war Utrecht",
        "description": "Kanaleneiland represents the large-scale expansion of the post-war city.",
        "alignment": "left",
        "hidden": false,
        "location": {
          "center": [
            5.0868,
            52.0687
          ],
          "zoom": 17.1,
          "pitch": 61,
          "bearing": -32
        },
        "mapAnimation": "flyTo",
        "rotateAnimation": false,
        "onChapterEnter": [
          {
            "layerId": "utrecht-bag-buildings",
            "opacity": 1
          }
        ],
        "onChapterExit": []
      },
      {
        "id": "leidsche-rijn",
        "title": "2000 to the present",
        "description": "Leidsche Rijn shifts the growth story westward and makes recent construction a major part of the present-day city.",
        "alignment": "right",
        "hidden": false,
        "location": {
          "center": [
            5.0345,
            52.096
          ],
          "zoom": 17.1,
          "pitch": 61,
