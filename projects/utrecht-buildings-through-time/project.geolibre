      "metadata": {
        "sourceKind": "ogc-vector-tiles",
        "sourceLayers": [
          "pand"
        ],
        "tilesUrl": "https://api.pdok.nl/kadaster/bag/ogc/v2/tiles/WebMercatorQuad/{z}/{y}/{x}?f=mvt",
        "styleUrl": "https://api.pdok.nl/kadaster/bag/ogc/v2/styles/bag_standaardvisualisatie__webmercatorquad?f=mapbox",
        "fields": [
          "bouwjaar",
          "gebruiksdoel",
          "status",
          "identificatie",
          "aantal_verblijfsobjecten"
        ],
        "geometryType": "polygon",
        "publisher": "Kadaster / PDOK",
        "license": "Public Domain Mark 1.0",
        "nativeLayerIds": [
          "layer-utrecht-bag-buildings-vector-circle",
          "layer-utrecht-bag-buildings-vector-line",
          "layer-utrecht-bag-buildings-vector"
        ],
        "timeBinding": {
          "property": "bouwjaar",
          "valueKind": "year",
          "min": -8520336000000,
          "max": 1767225600000,
          "granularity": "year",
          "window": {
            "unit": "year",
            "before": 0,
            "after": 1
          },
          "cumulative": true
        }
      },
      "filterExpression": [
        "all",
        [
          "has",
          "bouwjaar"
        ],
        [
          "!=",
          [
            "get",
            "status"
          ],
          "Pand gesloopt"
        ]
      ],
      "popup": {
        "click": true,
        "hover": true,
        "titleField": "identificatie",
        "showFeatureId": false,
        "fields": [
          {
            "field": "bouwjaar",
            "label": "Construction year",
            "kind": "number",
            "hover": true
          },
          {
            "field": "gebruiksdoel",
            "label": "Use",
            "hover": true
          },
          {
            "field": "status",
            "label": "BAG status"
          },
          {
            "field": "aantal_verblijfsobjecten",
            "label": "Addressable objects",
            "kind": "number"
          },
          {
            "field": "identificatie",
            "label": "BAG pand id"
          }
        ]
      },
      "capabilities": {
        "query": true,
        "create": false,
        "update": false,
        "delete": false,
        "export": false
      }
    },
