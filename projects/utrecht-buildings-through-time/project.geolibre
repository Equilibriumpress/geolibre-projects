          },
          {
            "value": 2000,
            "color": "#79a66a"
          },
          {
            "value": 2026,
            "color": "#3d8ca8"
          }
        ],
        "vectorStyleExpression": "[\"step\",[\"to-number\",[\"get\",\"bouwjaar\"],2026],\"#5b3a29\",1701,\"#8b5a3c\",1851,\"#bd743e\",1901,\"#d7a24b\",1951,\"#79a66a\",2001,\"#3d8ca8\"]",
        "vectorRules": [],
        "proportionalSizeEnabled": false,
        "proportionalSizeProperty": "",
