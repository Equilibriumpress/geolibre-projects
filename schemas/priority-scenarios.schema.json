{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equilibriumpress.github.io/GeoLibre/schemas/priority-scenarios.schema.json",
  "title": "Investment Priority Lab scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultScenario",
    "scenarios"
  ],
  "properties": {
    "defaultScenario": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "weights"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string"
          },
          "weights": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
