{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equilibriumpress.github.io/GeoLibre/schemas/project-outputs.schema.json",
  "title": "GeoLibre project output registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outputs"
  ],
  "properties": {
    "featured": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "kind",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "kind": {
            "enum": [
              "map",
              "dashboard",
              "story",
              "print",
              "atlas",
              "data",
              "analysis",
              "html",
              "video",
              "embed"
            ]
          },
          "mode": {
            "enum": [
              "deep-link",
              "published",
              "runtime-export",
              "repository"
            ]
          },
          "description": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "availability": {
            "enum": [
              "published",
              "runtime",
              "unavailable"
            ]
          },
          "action": {
            "enum": [
              "view",
              "prepare-export",
              "download"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "project",
                "webgl2",
                "media-recorder"
              ]
            }
          },
          "verifiedRevision": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
