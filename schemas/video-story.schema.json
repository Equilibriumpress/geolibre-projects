{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equilibriumpress.github.io/GeoLibre/schemas/video-story.schema.json",
  "title": "GeoLibre video story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "preset",
    "aspectRatio",
    "fps",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "preset": {
      "enum": [
        "tiktok",
        "reel",
        "short",
        "square",
        "standard",
        "custom"
      ]
    },
    "aspectRatio": {
      "enum": [
        "9:16",
        "1:1",
        "16:9"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "type",
          "durationMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "title",
              "map",
              "highlight",
              "chart",
              "kpi",
              "comparison",
              "conclusion",
              "cta"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 500,
            "maximum": 20000
          },
          "headline": {
            "type": "string"
          },
          "subhead": {
            "type": "string"
          },
          "scenarioId": {
            "type": "string"
          },
          "viewMode": {
            "enum": [
              "scenario",
              "consensus"
            ]
          },
          "sourceStoryChapterId": {
            "type": "string"
          },
          "layerId": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "widgetId": {
            "type": "string"
          },
          "transition": {
            "enum": [
              "cut",
              "fade",
              "fly"
            ]
          },
          "camera": {
            "type": "object",
            "required": [
              "center",
              "zoom"
            ],
            "properties": {
              "center": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "zoom": {
                "type": "number"
              },
              "pitch": {
                "type": "number"
              },
              "bearing": {
                "type": "number"
              },
              "transitionMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "caption": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "audioCue": {
            "type": "string"
          },
          "cues": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "kind",
                    "atMs",
                    "layerId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "layer"
                    },
                    "atMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "layerId": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "kind",
                    "atMs",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "annotation"
                    },
                    "atMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    },
                    "position": {
                      "enum": [
                        "top",
                        "center",
                        "bottom"
                      ]
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "kind",
                    "atMs",
                    "layerId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "highlight"
                    },
                    "atMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "layerId": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "operator": {
                      "enum": [
                        ">=",
                        ">",
                        "<=",
                        "<",
                        "==",
                        "!="
                      ]
                    },
                    "value": {}
                  }
                }
              ]
            }
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "routeLayerId": {
            "type": "string",
            "minLength": 1
          },
          "routeFollow": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "samples": {
                "type": "integer",
                "minimum": 2,
                "maximum": 48
              },
              "zoom": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "pitch": {
                "type": "number",
                "minimum": 0,
                "maximum": 85
              },
              "startFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "endFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "string"
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "narrationVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "bitrateMbps": {
          "type": "number",
          "minimum": 2,
          "maximum": 40
        },
        "showSafeArea": {
          "type": "boolean"
        },
        "includeBranding": {
          "type": "boolean"
        }
      }
    }
  }
}
